{
  "manifest_version": 3,
  "name": "Signet Passkeys",
  "version": "0.3.0",
  "description": "Approve this browser's passkey requests on your phone, wherever the phone is.",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
